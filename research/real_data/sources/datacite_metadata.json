,"givenName":"Andreas","familyName":"Krause","affiliation":["ETH Zurich"],"nameIdentifiers":[]},{"name":"Schölkopf, Bernhard","nameType":"Personal","givenName":"Bernhard","familyName":"Schölkopf","affiliation":["Max Planck Institute for Intelligent Systems"],"nameIdentifiers":[]},{"name":"Bauer, Stefan","nameType":"Personal","givenName":"Stefan","familyName":"Bauer","affiliation":["Max Planck Institute for Intelligent Systems"],"nameIdentifiers":[]},{"name":"Wüthrich, Manuel","nameType":"Personal","givenName":"Manuel","familyName":"Wüthrich","affiliation":["Max Planck Institute for Intelligent Systems"],"nameIdentifiers":[]}],"titles":[{"title":"A Real-Robot Dataset for Assessing Transferability of Learned Dynamics Models"}],"publisher":"Edmond","container":{},"publicationYear":2022,"subjects":[{"subject":"Computer Science, Systems and Electrical Engineering"},{"subject":"tranfer learning"},{"subject":"dynamics learning"},{"subject":"robotics"}],"contributors":[],"dates":[{"date":"2022-07-27","dateType":"Submitted"},{"date":"2022-07-27","dateType":"Available"},{"date":"2022","dateType":"Issued"}],"language":null,"types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[{"schemeUri":"https://ieeexplore.ieee.org","relationType":"IsSupplementTo","relatedIdentifier":"/document/9197392","relatedIdentifierType":"URL"}],"relatedItems":[],"sizes":["15121250","15121350","384001184","5041350","63841350","15121350","15121350","360001250","15121350","15121250","15121350","15121350","15121250","5041250","384001184","63841350","15121350","15121350","15121250","63841250","5041350"],"formats":["application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream","application/octet-stream"],"version":"1.0","rightsList":[{"rightsUri":"info:eu-repo/semantics/openAccess"},{"lang":"en","rights":"Creative Commons Zero v1.0 Universal","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc0-1.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"In the context of model-based reinforcement learning and control, a large number of methods for learning system dynamics have been proposed in recent years. The purpose of these learned models is to synthesize new control policies. An important open question is how robust current dynamics-learning methods are to shifts in the data distribution due to changes in the control policy. We present a real-robot dataset which allows to systematically investigate this question. This dataset contains trajectories of a 3 degrees-of-freedom (DOF) robot being controlled by a diverse set of policies. Software to reproduce our benchmark of a few widely-used dynamics-learning methods using the proposed dataset is available in our \u0026lt;a href=\"https://github.com/rr-learning/transferable_dynamics_dataset\"\u0026gt;code repository\u0026lt;/a\u0026gt;","descriptionType":"Abstract"},{"description":"https://github.com/rr-learning/transferable_dynamics_dataset","descriptionType":"TechnicalInfo"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://edmond.mpg.de/citation?persistentId=doi:10.17617/3.ZT6K7P","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOve